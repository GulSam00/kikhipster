{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/update-changelog.sh\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "docs/WORKLOG.md 커밋 이력 갱신 중"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/skills/issues/list-issues.mjs\" || true",
            "timeout": 10,
            "statusMessage": "열린 이슈 불러오는 중"
          }
        ]
      }
    ]
  }
}
