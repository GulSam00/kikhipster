# 루트 docker-compose.yml의 기본값과 맞춰둔 값. 다른 DB를 쓰면 이 줄만 교체하면 된다.
# 필수값 — 미설정 시 서버가 기동하지 않는다.
# RDS 등 SSL이 필요한 환경에서는 URL 끝에 ?sslmode=require 를 붙인다.
DATABASE_URL=postgresql://kikhipster:devpassword@localhost:5432/kikhipster

# 음악 API — iTunes Search API 사용, 인증 키 불필요 (공개 API)
MUSIC_DEFAULT_MARKET=KR

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Kakao OAuth (https://developers.kakao.com/)
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret

OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# CORS 허용 origin (콤마로 여러 개 지정 가능). 배포 시 프론트 도메인으로 교체.
CORS_ORIGINS=http://localhost:3000
